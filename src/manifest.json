{
  "manifest_version": 3,
  "name": "Brave Read Aloud",
  "version": "2.0.0",
  "description": "Read web pages & documents aloud with highlight & auto-scroll",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://*.tts.speech.microsoft.com/*",
    "https://texttospeech.googleapis.com/*",
    "https://speech.platform.bing.com/*",
    "wss://speech.platform.bing.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/pages/pdf-viewer/index.html", "src/pages/epub-viewer/index.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background/index.ts"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
